run = "bash run.sh"
entrypoint = "run.sh"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "bash run.sh"]
deploymentTarget = "cloudrun"

# Port 5000 → serves the React frontend (main webview)
# Port 8579 → WebSocket server (hindi_bot.py)
[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8579
externalPort = 8579
